# Copy this file to .env and fill in your real values. Never commit the
# real .env file (with your actual DB password / JWT secret) anywhere.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_PASSWORD
DB_NAME=BooksOfWorlds

# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING

PORT=3000

# Only needed if the HTML is served from a different origin/port than
# this backend. Not needed for the default same-origin setup.
# ALLOWED_ORIGIN=http://localhost:5500
